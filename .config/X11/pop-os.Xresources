! X resources for the host "pop-os" (ThinkPad laptop, 1366x768, urxvt).
! Loaded after the shared Xresources by ~/.bin/load-xresources.sh.

Xft.dpi: 90

! special
*.foreground:   #c0b18b
*.background:   #1f1f1f
*.cursorColor:  #c0b18b

! black
*.color0:       #4a3637
*.color8:       #4a3637

! red
*.color1:       #d17b49
*.color9:       #d17b49

! green
*.color2:       #7b8748
*.color10:      #7b8748

! yellow
*.color3:       #af865a
*.color11:      #af865a

! blue
*.color4:       #535c5c
*.color12:      #535c5c

! magenta
*.color5:       #775759
*.color13:      #775759

! cyan
*.color6:       #6d715e
*.color14:      #6d715e

! white
*.color7:       #c0b18b
*.color15:      #c0b18b

URxvt.scrollBar: false
!URxvt*font: xft:mono:medium:size=12
URxvt*font: xft:FantasqueSansM Nerd Font Mono:medium:size=12
URxvt.BorderWidth: 24
URxvt.internalBorder: 9
!URxvt.letterSpace: -1
URxvt*fading: 10
URxvt*fadeColor: #000000

! Pseudo-transparency: the wallpaper shows through the terminal background.
! shading is the brightness it is shown at: 100 is undimmed, lower is darker.
! The shared wallpaper is nearly black already, so it needs no dimming to keep
! text readable. Needs no compositor, but does need a wallpaper set on the root
! window, which ~/.config/i3/config.base does with feh.
URxvt*transparent: true
URxvt*shading: 100
